# Telegram bot token from @BotFather — stays in this process, never sent to FlowCastle.
BOT_TOKEN=123456:your-telegram-token
# FlowCastle dashboard → your application → Add bot → Code SDK → copy the fc_sdk_… key.
FLOWCASTLE_API_KEY=fc_sdk_...
# Optional: a deployed FlowCastle flow marked "callable from SDK" to run after /qualify completes.
# FLOWCASTLE_FOLLOW_UP_FLOW_KEY=lead-follow-up
